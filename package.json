{
  "name": "legacydiff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run build:module",
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend/database/spacetimedb",
    "test": "tsx --test tests/review.test.ts tests/investigation-retry.test.ts tests/client-connection.test.ts tests/architecture.test.ts tests/worker-runner.test.ts tests/worker-ai.test.ts tests/worker-evidence.test.ts backend/ai/*.test.ts frontend/src/presentation.test.ts tests/local-runtime.test.ts",
    "test:python": "python -m unittest discover -s tests/python -v",
    "worker": "tsx --env-file-if-exists=.env backend/worker/main.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration.test.ts tests/scenario-integration.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write frontend packages backend/ai backend/worker backend/database/spacetimedb/src tests/*.ts scripts/*.ts *.ts *.json",
    "format:check": "prettier --check frontend packages backend/ai backend/worker backend/database/spacetimedb/src tests/*.ts scripts/*.ts *.ts *.json",
    "db:start": "powershell -File scripts/start-database.ps1",
    "db:publish": "powershell -File scripts/publish-local.ps1",
    "build:module": "node scripts/spacetime.mjs build --module-path backend/database/spacetimedb",
    "browse": "tsx scripts/browse.ts",
    "browse:stop": "tsx scripts/browse.ts stop",
    "browse:refresh": "tsx scripts/browse.ts refresh"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spacetimedb": "2.14.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "latest",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "eslint": "10.14.0",
    "node": "24.22.1",
    "prettier": "3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
