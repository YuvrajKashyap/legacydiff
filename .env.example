# Private worker only. Never prefix secrets with VITE_.
NVIDIA_API_KEY=
# Optional only after authorized publication; full 40-character commit SHA.
GITHUB_EVIDENCE_COMMIT=
# Public browser configuration (never secrets):
VITE_SPACETIME_URI=ws://127.0.0.1:3000
VITE_SPACETIME_DATABASE=legacydiff-local-v2
VITE_WORKER_URL=http://127.0.0.1:3001
# Optional executable paths; defaults use local project Spacetime and python on PATH.
SPACETIME_CLI=.local/tools/spacetime/spacetimedb-cli.exe
PYTHON=python
